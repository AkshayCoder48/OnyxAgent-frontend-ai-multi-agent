# ============================================================================
# OnyxAgent — environment template. Copy to .env (never commit .env).
# Everything is OPTIONAL: the app is client-first (BYOK lives in the browser
# vault); these vars are the server-side baseline + operator conveniences.
# ============================================================================

# ── Durable sandbox browser (the browser_startup_failed fix) ────────────────
# Build the custom template ONCE (bakes cloakbrowser + the ~200MB stealth
# Chromium + Xvfb into the image) and every sandbox then boots the browser
# in SECONDS instead of pip-installing + downloading at runtime (~6-10 min):
#
#   bash scripts/build-browser-sandbox-template.sh
#
# E2B_TEMPLATE_ID=onyx-cloakbrowser

# ── Sandboxes ────────────────────────────────────────────────────────────────
# Server-side fallback E2B key (users normally bring their own in Settings).
# E2B_API_KEY=

# ── Database (server-side task/schedule/cloud-key store) ─────────────────────
# Defaults to db/custom.db (SQLite) when unset.
# DATABASE_URL=file:./db/custom.db

# ── Background tasks (Trigger.dev Cloud direct execution) ────────────────────
# Public origin of THIS deployment — the LLM bridge fallback, scheduled-run
# dispatch, and the cloud-fired schedule tick (/api/tasks/schedules/tick)
# all need it. Set it on the app server when deploying behind a proxy.
# APP_URL=https://your-app.example.com

# Operator convenience: connect a key from Settings → Cloud instead of this.
# TRIGGER_CLOUD_KEY=
# TRIGGER_CLOUD_TASK_SLUG=agent-run
# TRIGGER_CLOUD_API_URL=https://api.trigger.dev

# AES master key for sealing the Trigger.dev cloud key + worker token at
# rest (defaults to a generated db/cloud-config.key when unset).
# TASKS_CLOUD_MASTER_KEY=

# Auto worker deploy (Settings → Cloud → Deploy runs this itself):
# TRIGGER_PROJECT_REF=
# TRIGGER_ACCESS_TOKEN=

# ── Misc tool keys (server-side fallbacks) ────────────────────────────────────
# TAVILY_API_KEY=
